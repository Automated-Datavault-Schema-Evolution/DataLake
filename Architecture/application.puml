@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/archimate-plantuml/master/archimate.puml

' Define Application Layer Components
ArchimateApplicationComponent(baselineDir, "Baseline Directory", "Stores CSV files from local filesystems, SMTP servers, or fileshares")
ArchimateApplicationComponent(fileWatcher, "Filewatcher", "Monitors the baseline directory for file changes")
ArchimateApplicationComponent(kafkaService, "Kafka Service", "Streams file change events in real time")
ArchimateApplicationComponent(kafkaConsumer, "Kafka Consumer / PySpark", "Consumes the stream, processes CSV data, and converts it to dataframes")
ArchimateApplicationComponent(datalakeHandler, "Datalake Handler", "Stores data based on configuration: Parquet files or Postgres database")
ArchimateApplicationComponent(dataVaultRaw, "Data Vault (Raw)", "Stores raw ingested data")
ArchimateApplicationComponent(businessVault, "Business Vault", "Processes raw data for business analytics (optional)")
ArchimateApplicationComponent(presentationLayer, "Presentation Layer", "Exposes data as Star Schema views for BI tools")

' Define Relationships between Components
baselineDir --> fileWatcher : "Monitored by"
fileWatcher --> kafkaService : "Sends change events to"
kafkaService --> kafkaConsumer : "Streams data to"
kafkaConsumer --> datalakeHandler : "Sends processed data to"
datalakeHandler --> dataVaultRaw : "Stores data in"
dataVaultRaw --> businessVault : "Transfers data to (if enabled)"
dataVaultRaw --> presentationLayer : "Provides raw data for"
businessVault --> presentationLayer : "Provides business view for"

@enduml
